<?php

declare(strict_types=1);

/** @var \StORM\Bridges\StormTracy $this */

$agg = $this->getAggregated();
$panelId = 'storm_' . \preg_replace('/[^a-zA-Z0-9_]/', '_', $this->name);
$exportPath = $agg['exportPath'];

$tabs = [
	'slowest' => ['label' => 'Slowest', 'items' => $agg['slowest']],
	'frequent' => ['label' => 'Most frequent', 'items' => $agg['frequent']],
];

if ($agg['errorCount'] > 0) {
	$tabs['errors'] = ['label' => 'Errors (' . $agg['errorCount'] . ')', 'items' => $agg['errors']];
}

$sqlMaxLen = 150;

?>
<style>
#<?= $panelId ?> table { table-layout: fixed; width: 100%; border-collapse: collapse; }
#<?= $panelId ?> th, #<?= $panelId ?> td { padding: 3px 5px; border: 1px solid #e0e0e0; vertical-align: top; font-size: 12px; }
#<?= $panelId ?> .col-sql { width: auto; }
#<?= $panelId ?> .col-time { width: 150px; white-space: nowrap; }
#<?= $panelId ?> .col-vars { width: 70px; white-space: nowrap; }
#<?= $panelId ?> .col-copy { width: 75px; white-space: nowrap; text-align: center; }
#<?= $panelId ?> .sql-text { font: 11px/1.3 monospace; word-break: break-all; white-space: pre-wrap; }
#<?= $panelId ?> .tab-btn { padding: 4px 12px; cursor: pointer; border: 1px solid #ccc; background: #eee; border-radius: 3px 3px 0 0; border-bottom: none; font-size: 12px; }
#<?= $panelId ?> .tab-btn.active { background: #fff; font-weight: bold; }
#<?= $panelId ?> .tab-pane { display: none; }
#<?= $panelId ?> .tab-pane.active { display: block; }
#<?= $panelId ?> .slow-row { background-color: #FF7074; }
#<?= $panelId ?> .copy-btn { padding: 1px 8px; font-size: 11px; cursor: pointer; border: 1px solid #bbb; background: #f5f5f5; border-radius: 2px; font-family: inherit; }
#<?= $panelId ?> .copy-btn:hover { background: #e5e5e5; }
#<?= $panelId ?> .copy-btn.copied { background: #c8e6c9; border-color: #4caf50; color: #1b5e20; }
</style>

<div id="<?= $panelId ?>">
<div class="tracy-inner">
	<h1>StORM [<?= \htmlspecialchars($this->name) ?>] queries</h1>

	<p style="margin: 4px 0 8px; font-size: 13px;">
		<strong><?= $agg['totalAmount'] ?></strong> exec
		&middot; <strong><?= $agg['uniqueCount'] ?></strong> unique
		&middot; <strong><?= \round($agg['totalTime'], 3) ?>s</strong>
		<?php if ($agg['errorCount'] > 0): ?>
		&middot; <span style="color:red"><strong><?= $agg['errorCount'] ?></strong> errors</span>
		<?php endif ?>
		<?php if ($agg['uniqueCount'] > $this->panelLimit): ?>
		&middot; showing top <?= $this->panelLimit ?>
		<?php endif ?>
	</p>

	<?php if ($exportPath !== null): ?>
	<?php $editorUri = \Tracy\Helpers::editorUri($exportPath, 1); ?>
	<p style="margin: 0 0 8px; font-size: 12px; padding: 4px 8px; background: #f0f0f0; border-radius: 3px;">
		Full log (<?= $agg['uniqueCount'] ?> unique, <?= $agg['totalAmount'] ?> exec): <?php if ($editorUri !== null): ?><a href="<?= \htmlspecialchars($editorUri) ?>"><?= \htmlspecialchars($exportPath) ?></a><?php else: ?><code style="font-size: 11px; user-select: all;"><?= \htmlspecialchars($exportPath) ?></code><?php endif ?>
	</p>
	<?php endif ?>

	<div style="margin-bottom: 6px;">
		<?php $first = true; ?>
		<?php foreach ($tabs as $tabKey => $tab): ?>
		<button class="tab-btn<?= $first ? ' active' : '' ?>" onclick="<?= $panelId ?>_tab(this,'<?= $tabKey ?>')"><?= $tab['label'] ?></button>
		<?php $first = false; ?>
		<?php endforeach ?>
	</div>

	<?php $firstTab = true; ?>
	<?php foreach ($tabs as $tabKey => $tab): ?>
	<div class="tab-pane<?= $firstTab ? ' active' : '' ?>" data-tab="<?= $tabKey ?>">
		<table>
			<colgroup><col class="col-sql"><col class="col-time"><col class="col-vars"><col class="col-copy"></colgroup>
			<thead><tr><th>Query</th><th>Time</th><th>Vars</th><th></th></tr></thead>
			<tbody>
			<?php foreach ($tab['items'] as $item): ?>
				<?php
					$sql = $item->getSql();
					$copySql = \StORM\Bridges\StormTracy::interpolateSql($sql, $item->getVars());
					$itemTime = $item->getTotalTime();
					$percent = $agg['totalTime'] > 0 ? ($itemTime / $agg['totalTime']) * 100 : 0.0;
				?>
				<tr<?= $this->db->getDebugThreshold() !== null && $itemTime > $this->db->getDebugThreshold() ? ' class="slow-row"' : '' ?>>
					<td>
						<?php if ($item->hasError()): ?><span style="color:red">[ERR]</span> <?php endif ?>
						<span class="sql-text"><?= \htmlspecialchars(\mb_strlen($sql) > $sqlMaxLen ? \mb_substr($sql, 0, $sqlMaxLen) . ' …' : $sql) ?></span>
					</td>
					<td><?= \round($itemTime, 5) ?>s (<?= $item->getAmount() ?>x) <span style="color:#888"><?= \number_format($percent, 1) ?>%</span></td>
					<td><?= \count($item->getVars()) ?> vars</td>
					<td><button type="button" class="copy-btn" data-sql="<?= \htmlspecialchars($copySql, \ENT_QUOTES) ?>" onclick="<?= $panelId ?>_copy(this)">Copy</button></td>
				</tr>
			<?php endforeach ?>
			</tbody>
		</table>
	</div>
	<?php $firstTab = false; ?>
	<?php endforeach ?>
</div>
</div>

<script>
function <?= $panelId ?>_tab(btn, name) {
	var r = document.getElementById('<?= $panelId ?>');
	r.querySelectorAll('.tab-pane').forEach(function(e) { e.classList.remove('active'); });
	r.querySelectorAll('.tab-btn').forEach(function(e) { e.classList.remove('active'); });
	r.querySelector('.tab-pane[data-tab="' + name + '"]').classList.add('active');
	btn.classList.add('active');
}
function <?= $panelId ?>_copy(btn) {
	var sql = btn.getAttribute('data-sql') || '';
	var flash = function () {
		var original = btn.textContent;
		btn.textContent = 'Copied!';
		btn.classList.add('copied');
		setTimeout(function () {
			btn.textContent = original;
			btn.classList.remove('copied');
		}, 1200);
	};
	var fallback = function () {
		var ta = document.createElement('textarea');
		ta.value = sql;
		ta.style.position = 'fixed';
		ta.style.top = '0';
		ta.style.left = '0';
		ta.style.opacity = '0';
		document.body.appendChild(ta);
		ta.focus();
		ta.select();
		try { document.execCommand('copy'); flash(); } catch (e) { btn.textContent = 'Failed'; }
		document.body.removeChild(ta);
	};
	if (navigator.clipboard && navigator.clipboard.writeText) {
		navigator.clipboard.writeText(sql).then(flash, fallback);
	} else {
		fallback();
	}
}
</script>
